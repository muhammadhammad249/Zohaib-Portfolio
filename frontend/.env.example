# ── Local development ─────────────────────────────────────────────────────────
# Leave NEXT_PUBLIC_API_URL empty so the browser uses relative /api/* paths
# (proxied to localhost:5000 by next.config.mjs in dev mode).
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Vercel Services (injected automatically — do NOT set manually) ────────────
# BACKEND_URL is injected by the Vercel binding declared in root vercel.json.
# It is used by SSR / RSC server-side fetch calls to reach the backend service.
# BACKEND_URL=  ← set by Vercel; not needed in .env files
